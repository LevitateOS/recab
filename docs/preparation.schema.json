  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "completed_steps": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/PreparationPhase"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
