{
  "$comment": "Generated by `cargo xtask gen` from the tool's Rust output types. Do not edit.",
  "$defs": {
    "PreparationPhase": {
      "enum": [
        "intent",
        "awaiting_synchronization",
        "prepared",
        "staging",
        "ready",
        "interrupted"
      ],
      "type": "string"
    },
    "Slot": {
      "description": "System slot identifier (A/B). Its one spelling (`A`, `B`) is used by the\nCLI, the JSON and the state file.",
      "enum": [
        "A",
        "B"
      ],
      "type": "string"
    },
    "SyncReport": {
      "description": "Logical writes made by the synchronizer, not SSD/controller write amplification.",
      "properties": {
        "accounting_complete": {
          "description": "A killed attempt can have written data before its counters were saved.\nPayload counters cover this attempt; false means earlier writes are unknown.",
          "type": "boolean"
        },
        "entries_removed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "filesystem_journal_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "filesystem_metadata_bytes": {
          "description": "Filesystem metadata/journal traffic cannot be inferred from payload writes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hole_bytes_punched": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "identity_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "links_created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "metadata_updates": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload_bytes_compared": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "plan_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "range_writes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recab_state_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "resumed": {
          "type": "boolean"
        }
      },
      "required": [
        "payload_bytes_written",
        "payload_bytes_compared",
        "range_writes",
        "hole_bytes_punched",
        "files_created",
        "links_created",
        "entries_removed",
        "metadata_updates",
        "identity_bytes_written",
        "plan_bytes_written",
        "accounting_complete",
        "resumed"
      ],
      "type": "object"
    }
