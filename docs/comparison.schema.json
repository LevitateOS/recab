{
  "$comment": "Generated by `cargo xtask gen` from the tool's Rust output types. Do not edit.",
  "$defs": {
    "ComparedSystem": {
      "properties": {
        "bytes": {
          "description": "Length of every file, each hard-linked file once.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "Files and links, not folders.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent when two trees were compared and not this computer's slots."
        }
      },
      "required": [
        "files",
        "bytes"
      ],
      "type": "object"
    },
    "Difference": {
      "properties": {
        "change": {
          "$ref": "#/$defs/DifferenceKind"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "other_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "running_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "change",
        "running_bytes",
        "other_bytes"
      ],
      "type": "object"
    },
    "DifferenceKind": {
      "oneOf": [
        {
          "const": "only-running",
          "description": "Only the running system has it. A folder stands for all it holds.",
          "type": "string"
        },
        {
          "const": "only-other",
          "description": "Only the other system has it. A folder stands for all it holds.",
          "type": "string"
        },
        {
          "const": "content",
          "description": "Both have it and what it holds differs.",
          "type": "string"
        },
        {
          "const": "metadata",
          "description": "Same content; owner, mode, links, attributes or time differ.",
          "type": "string"
        }
      ]
    },
    "FolderSize": {
      "properties": {
        "other_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "running_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "running_bytes",
        "other_bytes"
      ],
      "type": "object"
    },
    "Same": {
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files",
        "bytes"
      ],
      "type": "object"
    },
    "Slot": {
      "description": "Root identifier (A/B). Its one spelling (`A`, `B`) is used by the CLI\nand the JSON.",
      "enum": [
        "A",
        "B"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "differences": {
      "items": {
        "$ref": "#/$defs/Difference"
      },
      "type": "array"
    },
    "folders": {
      "description": "Every folder down to [`FOLDER_DEPTH`] with all it holds, on both sides.",
      "items": {
        "$ref": "#/$defs/FolderSize"
      },
      "type": "array"
    },
    "more": {
      "description": "Differences left out of the list.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "other": {
      "$ref": "#/$defs/ComparedSystem"
    },
    "own": {
      "description": "Paths that differ by design and are not counted as differences.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "running": {
      "$ref": "#/$defs/ComparedSystem"
    },
    "same": {
      "$ref": "#/$defs/Same"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "running",
    "other",
    "same",
    "folders",
    "own",
    "differences",
    "more"
  ],
  "title": "Comparison",
  "type": "object"
}
