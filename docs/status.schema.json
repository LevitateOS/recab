      "type": "boolean"
    },
    "default_slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry_prefix": {
      "type": "string"
    },
    "inactive_slot": {
      "$ref": "#/$defs/Slot"
    },
    "known_good_slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_trial": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrialRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "How the last judged trial boot ended."
    },
    "lifecycle": {
      "$ref": "#/$defs/Lifecycle",
      "default": {
        "other": "unknown",
        "state": "stable",
        "working": null
      },
      "description": "The same facts as one state a person can be told; see [`Lifecycle`]."
    },
    "next_boot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ],
      "description": "The slot the next boot starts: the trial slot, else the default."
    },
    "preparation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Preparation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recovery_reason": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ],
      "description": "The slot `recab rollback` would select, if any."
    },
    "scheduled_trial": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
