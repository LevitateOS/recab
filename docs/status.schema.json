    "updates": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpdateStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "active_slot",
    "inactive_slot",
    "trial_pending",
    "committed",
    "entry_prefix",
