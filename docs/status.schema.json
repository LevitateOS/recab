{
  "$comment": "Generated by `cargo xtask gen` from the tool's Rust output types. Do not edit.",
  "$defs": {
    "Action": {
      "description": "A change a person or front end can ask recab for.",
      "oneOf": [
        {
          "enum": [
            "commit",
            "rollback",
            "prepare",
            "discard",
            "finalize"
          ],
          "type": "string"
        },
        {
          "const": "set_next",
          "description": "`recab set-next <inactive>`.",
          "type": "string"
        },
        {
          "const": "stage",
          "description": "`recab stage`.",
          "type": "string"
        }
      ]
    },
    "ActionView": {
      "description": "One action as recab's state machine plans it from the current state.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/After"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it leaves, when it is ready."
        },
        "reason": {
          "description": "Why it is refused (recab's message), when it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "$ref": "#/$defs/Slot",
          "description": "The slot it acts on."
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "action",
        "slot",
        "verdict"
      ],
      "type": "object"
    },
    "After": {
      "description": "The boot selection and slots an action leaves.",
      "properties": {
        "default_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_good_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_boot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "rollback_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "trial_pending": {
          "type": "boolean"
        }
      },
      "required": [
        "trial_pending"
      ],
      "type": "object"
    },
    "BootSeal": {
      "properties": {
        "architecture": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "kernel_release": {
          "type": "string"
        },
        "protocol": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "generation",
        "kernel_release",
        "architecture",
        "protocol"
      ],
      "type": "object"
    },
    "ChangeProgress": {
      "properties": {
        "action": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "invocation_io": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Entire recab invocation through cleanup, including the Recipe subprocess.\nAvailable in the returned result; the persisted receipt predates cleanup.\nFinal result serialization follows this observation.",
          "type": [
            "object",
            "null"
          ]
        },
        "package": {
          "type": "string"
        },
        "producer_io": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Recipe /proc/self/io deltas, including reaped children and streams.\nNot physical SSD traffic; null means unmeasured.",
          "type": [
            "object",
            "null"
          ]
        },
        "projection_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "action",
        "package",
        "projection_bytes_written"
      ],
      "type": "object"
    },
    "Finalization": {
      "properties": {
        "accounting_complete": {
          "type": "boolean"
        },
        "boot_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "boot_metadata_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "initrd_source": {
          "type": "string"
        },
        "kernel_source": {
          "type": "string"
        },
        "reused_boot_files": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seal": {
          "$ref": "#/$defs/BootSeal"
        }
      },
      "required": [
        "generation",
        "seal",
        "kernel_source",
        "initrd_source",
        "boot_bytes_written",
        "boot_metadata_bytes_written",
        "reused_boot_files",
        "accounting_complete"
      ],
      "type": "object"
    },
    "Generation": {
      "properties": {
        "id": {
          "type": "string"
        },
        "initrd_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "inventory_digest": {
          "type": "string"
        },
        "kernel_digest": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "inventory_digest",
        "kernel_digest"
      ],
      "type": "object"
    },
    "Preparation": {
      "properties": {
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_steps": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "finalization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finalization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "last_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PreparationPhase"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "source_generation": {
          "type": "string"
        },
        "source_slot": {
          "$ref": "#/$defs/Slot"
        },
        "synchronization": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synchronized": {
          "default": false,
          "description": "Once synchronized, reopening must never reseed pending system changes.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "slot",
        "source_slot",
        "source_generation",
        "revision",
        "operation",
        "phase",
        "completed_steps"
      ],
      "type": "object"
    },
    "PreparationPhase": {
      "enum": [
        "intent",
        "awaiting_synchronization",
        "prepared",
        "staging",
        "finalizing",
        "ready",
        "interrupted"
      ],
      "type": "string"
    },
    "Readiness": {
      "enum": [
        "empty",
        "incomplete",
        "ready",
        "committed"
      ],
      "type": "string"
    },
    "Slot": {
      "description": "System slot identifier (A/B). Its one spelling (`A`, `B`) is used by the\nCLI, the JSON and the state file.",
      "enum": [
        "A",
        "B"
      ],
      "type": "string"
    },
    "SlotView": {
      "description": "One slot's layout on the ESP, as recab wrote it.",
      "properties": {
        "boot_dir": {
          "description": "The directory of its kernel and initramfs, relative to the ESP.",
          "type": "string"
        },
        "bootable": {
          "description": "Every file the entry loads is on the ESP.",
          "type": "boolean"
        },
        "device": {
          "description": "The block device `root` names on this machine, if present.",
          "type": [
            "string",
            "null"
          ]
        },
        "entry": {
          "description": "The entry file, relative to the ESP (`loader/entries/<prefix>-a.conf`).",
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Generation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generation_ready": {
          "default": false,
          "type": "boolean"
        },
        "initrd": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kernel": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Readiness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "root": {
          "description": "The entry's `root=` (`PARTUUID=...`), if it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "seal": {
          "anyOf": [
            {
              "$ref": "#/$defs/BootSeal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "trial": {
          "description": "The entry carries a trial's options (it was staged or scheduled and\nnot yet committed).",
          "type": "boolean"
        }
      },
      "required": [
        "slot",
        "entry",
        "boot_dir",
        "bootable",
        "trial"
      ],
      "type": "object"
    },
    "SyncReport": {
      "description": "Logical writes made by the synchronizer, not SSD/controller write amplification.",
      "properties": {
        "accounting_complete": {
          "description": "A killed attempt can have written data before its counters were saved.\nPayload counters cover this attempt; false means earlier writes are unknown.",
          "type": "boolean"
        },
        "entries_removed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "filesystem_journal_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "filesystem_metadata_bytes": {
          "description": "Filesystem metadata/journal traffic cannot be inferred from payload writes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hole_bytes_punched": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "identity_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "links_created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "metadata_updates": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload_bytes_compared": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "plan_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "range_writes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recab_state_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "resumed": {
          "type": "boolean"
        }
      },
      "required": [
        "payload_bytes_written",
        "payload_bytes_compared",
        "range_writes",
        "hole_bytes_punched",
        "files_created",
        "links_created",
        "entries_removed",
        "metadata_updates",
        "identity_bytes_written",
        "plan_bytes_written",
        "accounting_complete",
        "resumed"
      ],
      "type": "object"
    },
    "TrialRecord": {
      "description": "How the last judged trial boot ended (kept in the state file, and shown\nas is by `status`).",
      "properties": {
        "committed": {
          "description": "The trial was healthy and committed; otherwise it was abandoned.",
          "type": "boolean"
        },
        "detail": {
          "description": "How startup ended, and the failed units if any.",
          "type": "string"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "unix_time": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "slot",
        "committed",
        "detail",
        "unix_time"
      ],
      "type": "object"
    },
    "Verdict": {
      "description": "What recab would make of an action now.",
      "oneOf": [
        {
          "enum": [
            "ready",
            "refused"
          ],
          "type": "string"
        },
        {
          "const": "no_change",
          "description": "The system already is where it leads.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Current A/B view exported by `recab status --json`.",
  "properties": {
    "actions": {
      "description": "What recab would make of each action now.",
      "items": {
        "$ref": "#/$defs/ActionView"
      },
      "type": "array"
    },
    "active_slot": {
      "$ref": "#/$defs/Slot"
    },
    "committed": {
      "description": "The running slot is the known-good slot. After a trial boot this is\nfalse until it is committed; an uncommitted slot is left on next boot.",
      "type": "boolean"
    },
    "default_slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry_prefix": {
      "type": "string"
    },
    "inactive_slot": {
      "$ref": "#/$defs/Slot"
    },
    "known_good_slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_trial": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrialRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "How the last judged trial boot ended."
    },
    "next_boot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ],
      "description": "The slot the next boot starts: the trial slot, else the default."
    },
    "preparation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Preparation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recovery_reason": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ],
      "description": "The slot `recab rollback` would select, if any."
    },
    "scheduled_trial": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slot"
        },
        {
          "type": "null"
        }
      ],
      "description": "The slot `set-next` scheduled and no boot has judged yet."
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "slots": {
      "description": "Each slot's entry, kernel directory and partition.",
      "items": {
        "$ref": "#/$defs/SlotView"
      },
      "type": "array"
    },
    "trial_pending": {
      "description": "A one-shot trial boot is set in the firmware and not yet taken.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "active_slot",
    "inactive_slot",
    "trial_pending",
    "committed",
    "entry_prefix",
    "slots",
    "actions"
  ],
  "title": "Status",
  "type": "object"
}
