{
  "$comment": "Generated by `cargo xtask gen` from the tool's Rust output types. Do not edit.",
  "$defs": {
    "Action": {
      "description": "A change a person or front end can ask recab for.",
      "oneOf": [
        {
          "enum": [
            "commit",
            "rollback",
            "prepare",
            "discard",
            "finalize"
          ],
          "type": "string"
        },
        {
          "const": "set_next",
          "description": "`recab set-next <inactive>`.",
          "type": "string"
        },
        {
          "const": "stage",
          "description": "`recab stage`.",
          "type": "string"
        }
      ]
    },
    "ActionView": {
      "description": "One action as recab's state machine plans it from the current state.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/After"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it leaves, when it is ready."
        },
        "reason": {
          "description": "Why it is refused (recab's message), when it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "$ref": "#/$defs/Slot",
          "description": "The slot it acts on."
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "action",
        "slot",
        "verdict"
      ],
      "type": "object"
    },
    "After": {
      "description": "The boot selection and slots an action leaves.",
      "properties": {
        "default_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_good_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_boot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "rollback_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ]
        },
        "trial_pending": {
          "type": "boolean"
        }
      },
      "required": [
        "trial_pending"
      ],
      "type": "object"
    },
    "BootSeal": {
      "properties": {
        "architecture": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "kernel_release": {
          "type": "string"
        },
        "protocol": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "generation",
        "kernel_release",
        "architecture",
        "protocol"
      ],
      "type": "object"
    },
    "ChangeProgress": {
      "properties": {
        "action": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "invocation_io": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Entire recab invocation through cleanup, including the Recipe subprocess.\nAvailable in the returned result; the persisted receipt predates cleanup.\nFinal result serialization follows this observation.",
          "type": [
            "object",
            "null"
          ]
        },
        "package": {
          "type": "string"
        },
        "producer_io": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Recipe /proc/self/io deltas, including reaped children and streams.\nNot physical SSD traffic; null means unmeasured.",
          "type": [
            "object",
            "null"
          ]
        },
        "projection_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "action",
        "package",
        "projection_bytes_written"
      ],
      "type": "object"
    },
    "ChangeRecord": {
      "description": "One finished change of a preparation: what a person reads as \"the next\nsystem holds these changes\". The reports of a change stay in\n[`Preparation::last_change`]; this is the list.",
      "properties": {
        "action": {
          "description": "`install`, `update`, `remove` or `edit`.",
          "type": "string"
        },
        "actor": {
          "default": null,
          "description": "Who asked for it, as the caller named itself (`--actor`): a label for\nthe person reading, not an authenticated identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "package": {
          "description": "The recipe's package, or the edited path.",
          "type": "string"
        },
        "unix_time": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "action",
        "package",
        "unix_time"
      ],
      "type": "object"
    },
    "Conflict": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "path_hex": {
          "type": "string"
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "path_hex",
        "kind"
      ],
      "type": "object"
    },
    "DownloadProgress": {
      "properties": {
        "accounting_complete": {
          "description": "False when a previous failed producer may have written unreported bytes.",
          "type": "boolean"
        },
        "downloaded": {
          "type": "boolean"
        },
        "producer_cancelled_write_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "producer_write_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "release": {
          "type": "string"
        },
        "reused_files": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_files": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "verified_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verified_files": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "release",
        "verified_files",
        "total_files",
        "verified_bytes",
        "total_bytes",
        "reused_files",
        "producer_write_bytes",
        "producer_cancelled_write_bytes",
        "downloaded",
        "accounting_complete"
      ],
      "type": "object"
    },
    "Finalization": {
      "properties": {
        "accounting_complete": {
          "type": "boolean"
        },
        "boot_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "boot_metadata_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "initrd_source": {
          "type": "string"
        },
        "kernel_source": {
          "type": "string"
        },
        "reused_boot_files": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seal": {
          "$ref": "#/$defs/BootSeal"
        }
      },
      "required": [
        "generation",
        "seal",
        "kernel_source",
        "initrd_source",
        "boot_bytes_written",
        "boot_metadata_bytes_written",
        "reused_boot_files",
        "accounting_complete"
      ],
      "type": "object"
    },
    "Generation": {
      "properties": {
        "id": {
          "type": "string"
        },
        "initrd_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "inventory_digest": {
          "type": "string"
        },
        "kernel_digest": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "inventory_digest",
        "kernel_digest"
      ],
      "type": "object"
    },
    "Lifecycle": {
      "properties": {
        "other": {
          "$ref": "#/$defs/OtherSystem"
        },
        "state": {
          "$ref": "#/$defs/LifecycleState"
        },
        "working": {
          "description": "A recab command holds the run lock right now. `None` when this reader\nmay not open the lock file.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "other"
      ],
      "type": "object"
    },
    "LifecycleState": {
      "description": "Where the two systems stand, in the terms a person is told. recab works\nit out here, once, from its own state, so that no front end rebuilds it\nfrom slots and phases and gets it wrong.",
      "oneOf": [
        {
          "const": "stable",
          "description": "The running system is kept; nothing is prepared and no restart is set.",
          "type": "string"
        },
        {
          "const": "open",
          "description": "A preparation is open and takes changes. It cannot be started yet.",
          "type": "string"
        },
        {
          "const": "working",
          "description": "A recab command is working on the preparation right now.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "The preparation was left in the middle of an operation and no command\nis running: it must be continued or discarded.",
          "type": "string"
        },
        {
          "const": "ready",
          "description": "The candidate is finalized; no restart into it is set.",
          "type": "string"
        },
        {
          "const": "restart_set",
          "description": "A restart into the other system is set: the next start takes it.",
          "type": "string"
        },
        {
          "const": "on_trial",
          "description": "The running system is a trial that is not kept yet; a restart goes\nback to the one before.",
          "type": "string"
        },
        {
          "const": "trial_failed",
          "description": "The candidate was tried, did not start properly, and the computer\ncame back. The candidate is still there. Told from the last judged\ntrial, which names a slot and not a generation: a candidate finalized\nagain since then is still reported this way until it is tried.",
          "type": "string"
        },
        {
          "const": "unusable",
          "description": "The installation is incomplete or the state needs recovery; see\n`recovery_reason`.",
          "type": "string"
        }
      ]
    },
    "MergeStatus": {
      "properties": {
        "conflicts": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array"
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": "string"
        },
        "preparation": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unresolved": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "preparation",
        "revision",
        "release",
        "phase",
        "conflicts",
        "unresolved"
      ],
      "type": "object"
    },
    "OtherSystem": {
      "description": "What the other system is to the running one.",
      "oneOf": [
        {
          "const": "copy",
          "description": "It holds the same generation: a second copy of the running system.",
          "type": "string"
        },
        {
          "const": "previous",
          "description": "It is the known-good system from before, which rollback returns to.",
          "type": "string"
        },
        {
          "const": "next",
          "description": "It is being prepared, is finalized, or is set for the next start.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "None of these can be said.",
          "type": "string"
        }
      ]
    },
    "Preparation": {
      "properties": {
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "changes": {
          "default": [],
          "description": "Every change finished in this preparation, oldest first.",
          "items": {
            "$ref": "#/$defs/ChangeRecord"
          },
          "type": "array"
        },
        "completed_steps": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "finalization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finalization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "last_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PreparationPhase"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "source_generation": {
          "type": "string"
        },
        "source_slot": {
          "$ref": "#/$defs/Slot"
        },
        "synchronization": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synchronized": {
          "default": false,
          "description": "Once synchronized, reopening must never reseed pending system changes.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "slot",
        "source_slot",
        "source_generation",
        "revision",
        "operation",
        "phase",
        "completed_steps"
      ],
      "type": "object"
    },
    "PreparationPhase": {
      "enum": [
        "intent",
        "awaiting_synchronization",
        "prepared",
        "staging",
        "finalizing",
        "ready",
        "interrupted"
      ],
      "type": "string"
    },
    "Readiness": {
      "enum": [
        "empty",
        "incomplete",
        "ready",
        "committed"
      ],
      "type": "string"
    },
    "ReleaseSummary": {
      "properties": {
        "channel": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sequence",
        "version",
        "channel",
        "total_bytes"
      ],
      "type": "object"
    },
    "Slot": {
      "description": "System slot identifier (A/B). Its one spelling (`A`, `B`) is used by the\nCLI, the JSON and the state file.",
      "enum": [
        "A",
        "B"
      ],
      "type": "string"
    },
    "SlotView": {
      "description": "One slot's layout on the ESP, as recab wrote it.",
      "properties": {
        "boot_dir": {
          "description": "The directory of its kernel and initramfs, relative to the ESP.",
          "type": "string"
        },
        "bootable": {
          "description": "Every file the entry loads is on the ESP.",
          "type": "boolean"
        },
        "device": {
          "description": "The block device `root` names on this machine, if present.",
          "type": [
            "string",
            "null"
          ]
        },
        "entry": {
          "description": "The entry file, relative to the ESP (`loader/entries/<prefix>-a.conf`).",
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Generation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generation_ready": {
          "default": false,
          "type": "boolean"
        },
        "initrd": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kernel": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Readiness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "root": {
          "description": "The entry's `root=` (`PARTUUID=...`), if it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "seal": {
          "anyOf": [
            {
              "$ref": "#/$defs/BootSeal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "trial": {
          "description": "The entry carries a trial's options (it was staged or scheduled and\nnot yet committed).",
          "type": "boolean"
        }
      },
      "required": [
        "slot",
        "entry",
        "boot_dir",
        "bootable",
        "trial"
      ],
      "type": "object"
    },
    "SyncReport": {
      "description": "Logical writes made by the synchronizer, not SSD/controller write amplification.",
      "properties": {
        "accounting_complete": {
          "description": "A killed attempt can have written data before its counters were saved.\nPayload counters cover this attempt; false means earlier writes are unknown.",
          "type": "boolean"
        },
        "entries_removed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "filesystem_journal_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "filesystem_metadata_bytes": {
          "description": "Filesystem metadata/journal traffic cannot be inferred from payload writes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hole_bytes_punched": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "identity_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "links_created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "metadata_updates": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload_bytes_compared": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "plan_bytes_written": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "range_writes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recab_state_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "resumed": {
          "type": "boolean"
        }
      },
      "required": [
        "payload_bytes_written",
        "payload_bytes_compared",
        "range_writes",
        "hole_bytes_punched",
        "files_created",
        "links_created",
        "entries_removed",
        "metadata_updates",
        "identity_bytes_written",
        "plan_bytes_written",
        "accounting_complete",
        "resumed"
      ],
      "type": "object"
    },
    "TrialRecord": {
      "description": "How the last judged trial boot ended (kept in the state file, and shown\nas is by `status`).",
      "properties": {
        "committed": {
          "description": "The trial was healthy and committed; otherwise it was abandoned.",
          "type": "boolean"
        },
        "detail": {
          "description": "How startup ended, and the failed units if any.",
          "type": "string"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "unix_time": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "slot",
        "committed",
        "detail",
        "unix_time"
      ],
      "type": "object"
    },
    "UpdateStatus": {
      "properties": {
        "available": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "download": {
          "anyOf": [
            {
              "$ref": "#/$defs/DownloadProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "highest_index": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergeStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "merge_complete": {
          "description": "P08 selects/validates the release; filesystem merging is owned by P09.",
          "type": "boolean"
        },
        "pending_preparation": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "highest_index",
        "merge_complete"
      ],
      "type": "object"
    },
    "Verdict": {
      "description": "What recab would make of an action now.",
      "oneOf": [
        {
          "enum": [
            "ready",
            "refused"
          ],
          "type": "string"
        },
        {
          "const": "no_change",
          "description": "The system already is where it leads.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Current A/B view exported by `recab status --json`.",
  "properties": {
    "actions": {
      "description": "What recab would make of each action now.",
      "items": {
        "$ref": "#/$defs/ActionView"
      },
      "type": "array"
    },
    "active_slot": {
      "$ref": "#/$defs/Slot"
    },
