# Packaged by `recab install-unit --init systemd`. It waits for startup to
# finish; it must not be part of what startup waits for, so it is Type=exec.
[Unit]
Description=@DESCRIPTION@
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
IgnoreOnIsolate=yes

[Service]
Type=exec
ExecStart=@RECAB@ started

[Install]
WantedBy=@WANTED_BY@
