#!/sbin/openrc-run
# The trial service, packaged by `recab install-unit --init openrc`.
description="@DESCRIPTION@"

# openrc-run runs it in the background and stops it at shutdown (no
# verdict then); its one line goes to the kernel log, OpenRC having no
# journal.
command="@RECAB@"
command_args="trial"
command_background=true
pidfile="/run/recab-trial.pid"
output_log="/dev/kmsg"
error_log="/dev/kmsg"

depend() {
	# sysfs mounts efivarfs, which tells a trial boot from the firmware.
	after sysfs
}
